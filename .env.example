# Copie este arquivo para .env e cole sua chave. O .env NUNCA vai para o git.

# ---- Obrigatório: chave da LLM ----
# Gemini (gratuita): https://aistudio.google.com/apikey
LLM_API_KEY=cole_sua_chave_aqui

# ---- Opcional: já vêm com estes valores ----
# Modelo usado pelo agent
LLM_MODELO=gemini-2.5-flash

# Endereço da API, compatível com o SDK da OpenAI.
# Para usar outro provedor, troque o endereço e o modelo. Exemplo com Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODELO=llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Simula o sistema de chamados "legado" ficando fora do ar por alguns segundos (true/false)
SISTEMA_INSTAVEL=true
